          "w": 693,
          "h": 129,
          "kind": "text",
          "segments": [
            {
              "text": "정비가 완료된 후, 사용자의 일정에 따라 PV5 원격 복귀와 직접 수령 중 원하는 과정을 선택할 수 있습니다. 상황에 맞는 복귀 방식을 제공하여 정비 이후의 과정까지 자연스럽게 연결합니다.",
              "font": "SUIT",
              "weight": 300,
              "size": 24,
              "spacing": 0,
              "line": 1.8,
              "color": "rgb(103 103 103)",
              "uppercase": true
