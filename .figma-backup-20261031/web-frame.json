        },
        {
          "id": "2919:614",
          "x": 970,
          "y": 3623,
          "w": 930,
          "h": 129,
          "kind": "text",
          "segments": [
            {
              "text": "사고가 발생하면 이륜차 운전자는 현장 대응부터 정비소 탐색, 수리 견적 확인과 이동 복귀까지 서로 다른 주체와 연락하며 해결 과정을 직접 관리해야 합니다. 사고 상황과 차량 상태를 여러 곳에 반복해서 설명하고, 각 단계의 진행 상황과 다음에 해야 할 일을 개별적으로 확인해야 하는 구조입니다.",
              "font": "SUIT",
              "weight": 300,
              "size": 24,
              "spacing": 0,
              "line": 1.8,
              "color": "rgb(103 103 103)",
              "uppercase": true
            }
          ]
        }
      ]
