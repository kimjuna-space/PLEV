        {
          "id": "2892:1044",
          "x": 20,
          "y": 1160,
          "w": 252,
          "h": 112,
          "kind": "text",
          "segments": [
            {
              "text": "사고 이후를\n하나의 흐름으로",
              "font": "Archivo",
              "weight": 700,
              "size": 40,
              "spacing": -0.05,
              "line": 1.4,
              "color": "rgb(0 0 0)",
              "uppercase": true
            }
          ]
        },
        {
          "id": "2892:972",
          "x": 970,
          "y": 1160,
          "w": 930,
          "h": 240,
          "kind": "text",
          "segments": [
            {
              "text": "PLEV는 ‘사고 이후를 하나의 흐름으로’ 라는 가치를 바탕으로,  분산된 이륜차 사고 처리와 이동 과정을 PV5를 통해 연결하는 서비스입니다. 현장 조치부터 정비소 이동, 정비 후 자택 이송까지 사고 이후 필요한 과정을 지원합니다. 운전자가 단계마다 다른 업체를 찾고 개별적으로 요청해야 했던 절차를 하나의 플랫폼에서 접수하고 연계하여 일관된 흐름으로 제공합니다. 이를 통해 운전자의 조율 부담을 줄이고 현장 대응부터 정비와 최종 이송까지 모든 단계가 유기적으로 연결되는 서비스 경험을 제안합니다.",
              "font": "SUIT",
              "weight": 300,
              "size": 24,
              "spacing": -0.025,
              "line": 2,
              "color": "rgb(103 103 103)",
              "uppercase": true
            }
          ]
        }
      ]
    },
