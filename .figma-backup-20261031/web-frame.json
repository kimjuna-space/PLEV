          "y": 3623,
          "w": 257,
          "h": 132,
          "kind": "text",
          "segments": [
            {
              "text": "the ride\n pauses.",
              "font": "Archivo",
              "weight": 600,
              "size": 60,
              "spacing": -0.05,
              "line": 1.1,
              "color": "rgb(0 0 0)",
              "uppercase": true
